# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv

# Environment Variables
.env
.env.local
config.json
# The app rewrites config.json in place and drops the previous copy beside it
# as config.json.bak (and dated config.json.bak.<stamp> variants). Those are
# copies of a real runtime config, so they carry exactly the same secrets
# config.json does and must never be committed. Ignoring config.json alone
# does not cover them: the pattern is literal, not a prefix.
config.json.bak
config.json.bak.*

# Authentication
totp-qr.png
# TOTP pairing sentinel (runtime state)
.totp_paired

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
/tmp/
*.log.*

# Session Data
session_metadata.json
pinned_themes.json
unread_state.json
/claude-projects/

# Image Uploads (per-session bucket — must never be committed)
.cloude_uploads/

# Auth State (refresh-token store — must never be committed)
refresh_tokens.db

# Test Coverage
.coverage
htmlcov/
.pytest_cache/

# Claude
.prompt_history/
troubleshooting/

.superpowers/

# Runtime lock files (session-scoped, PID-stamped — never meant to be tracked)
.claude/scheduled_tasks.lock

# CLAUDE.md is TRACKED here on purpose. It is the repo's agent orientation
# doc, not a personal scratch file. A global excludesFile that ignores
# CLAUDE.md would otherwise keep it out of every commit silently; this
# negation wins because repo .gitignore is read after core.excludesFile.
!CLAUDE.md

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Session Configuration
DEFAULT_WORKING_DIR=~/claude-projects
SESSION_TIMEOUT=3600

# Logging
LOG_BUFFER_SIZE=1000
LOG_FILE_RETENTION=7
LOG_DIRECTORY=/tmp/claude-code-logs

# Tunnels
TUNNEL_PROVIDER=cloudflare
AUTO_CREATE_TUNNELS=true
TUNNEL_TIMEOUT=30

# Security (Optional)
API_KEY=
ALLOWED_ORIGINS=*

# Tmux
TMUX_SOCKET_NAME=claude-controller

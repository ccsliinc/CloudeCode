{
  "name": "cloudecode-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Svelte 5 + TypeScript + Tailwind build for the strangler migration of client/. Emits fixed-name assets into client/dist/, which FastAPI serves under /static/dist/.",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.11.2",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}

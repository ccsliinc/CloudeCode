{
  "name": "cloude-code-menubar",
  "version": "1.0.0",
  "description": "macOS menu bar app for Cloude Code remote control",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "package": "electron-builder --mac --publish never"
  },
  "keywords": [
    "electron",
    "menubar",
    "claude",
    "macos"
  ],
  "author": "Cloude Code",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.2"
  },
  "build": {
    "appId": "com.cloudecode.menubar",
    "productName": "Cloude Code",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "../src/**/*",
      "../client/**/*",
      "../venv/**/*",
      "../.env",
      "../config.json",
      "../requirements.txt",
      "../setup.sh",
      "../start.sh",
      "../stop.sh"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ]
    }
  }
}
